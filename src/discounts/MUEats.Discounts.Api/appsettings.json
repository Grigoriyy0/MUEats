{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Username=postgres;Password=postgres;Database=mue.discounts"
  },
  "AuthOptions": {
    "Issuer": "mueats.server",
    "Audience": "mueats.client",
    "AccessTokenExpirationMinutes": 20,
    "RefreshTokenExpirationDays": 30,
    "PublicKeyPath": "./public_key.pem"
  },
  "KafkaOptions": {
    "BootstrapServers": "localhost:9092",
    "ConsumerOptions": {
      "FoodItemDeletedEvent": {
        "Topic" : "fooditems.deleted"
      },
      "RestaurantDeletedEvent": {
        "Topic" : "restaurants.deleted"
      },
      "RoleDeletedEvent":{
        "Topic": "roles.deleted"
      },
      "RoleUpdatedEvent": {
        "Topic": "roles.updated"
      }
    }
  }
}
